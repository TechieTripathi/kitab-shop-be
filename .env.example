port=3000

acess_token=

refresh_token=


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=



supabaseurl=

project_url=

#pasword
SECRET_KEY=




EMAIL=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:3000



# MongoDB connection string. `mango_url` is kept for existing scripts; the app
# also accepts MONGO_URI, MONGODB_URI, MONGO_URL, and mongo_url.
mango_url=


# Images are stored on local disk and served from /uploads.
# Leave blank to use <repo>/uploads. In production point this at a mounted
# volume outside the deploy directory so a redeploy cannot wipe the catalogue,
# and back it up separately — db:backup does not cover the filesystem.
UPLOADS_DIR=


RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=demo
RAZORPAY_WEBHOOK_ENABLED=false
GOOGLE_CLIENT_ID=

# Shiprocket API user credentials (Settings > API > Configure)
SHIPROCKET_ENABLED=false
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_AUTO_CREATE_ORDER=false
SHIPROCKET_ADMIN_ONLY=true
SHIPROCKET_WEBHOOK_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5

INVENTORY_ENFORCE_STOCK=true
INVENTORY_RESERVE_DURING_PAYMENT=true
LOW_STOCK_THRESHOLD=5

AUTH_SECURITY_ENABLED=false
REFRESH_TOKEN_COOKIE_ENABLED=true
REFRESH_TOKEN_COOKIE_NAME=astromart_refresh_token
RATE_LIMIT_STORE=memory
REDIS_URL=

NOTIFICATIONS_ENABLED=false
NOTIFY_SMS_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_PHONE_ENABLED=false

# Public storefront origin, used to build sitemap.xml and robots.txt.
# Falls back to FRONTEND_URL when unset.
SITE_URL=
