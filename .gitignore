# Dependencies
node_modules/

# Environment files
.env
.env.local
.env.production
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / build output
dist/
build/
coverage/
.nyc_output/
tmp/
temp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database dumps from scripts/backup-db.sh
backups/
*.archive.gz

# Uploaded images (served from /uploads). Back these up separately from
# db:backup — mongodump does not cover the disk.
uploads/

# uploads/static/ is the exception: frontend assets fetched once by
# scripts/fetch-static-images.js, not user uploads, so they are committed.
!uploads/static/
!uploads/static/**
